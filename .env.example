# Copy to .env.local and fill in your Spotify app's client ID.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your-client-id
# Must match the redirect URI registered in the Spotify dashboard exactly.
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/login-callback
NEXT_PUBLIC_SPOTIFY_API_URL=https://api.spotify.com/v1
